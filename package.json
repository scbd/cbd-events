{
  "name": "cbd-events",
  "version": "5.0.1",
  "description": "cbd-events app",
  "author": "Secretariat of the Convention on Biological Diversity <it@cbd.int>",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build:a": "NODE_ENV=android nuxt generate && cd capacitor && yarn jetify && yarn cap sync android",
    "build:i": "NODE_ENV=ios nuxt generate && cd capacitor && yarn cap sync ios",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean-reinstall": "rm -f yarn.lock && rm -f package-lock.json &&  rm -rf node_modules && CXXFLAGS=\"--std=c++17\" yarn install --force"
  },
