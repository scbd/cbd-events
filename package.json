{
  "name": "cbd-events",
  "version": "5.0.3",
  "description": "cbd-events app",
  "author": "Secretariat of the Convention on Biological Diversity <it@cbd.int>",
  "private": true,
  "scripts": {
    "dev": "rm -rf .nuxt  &&  NODE_ENV=local nuxt --open",
    "build:a": "rm -rf .nuxt && NODE_ENV=android nuxt generate && cd capacitor && yarn jetify && yarn cap sync android",
    "build:i": "rm -rf .nuxt && NODE_ENV=ios nuxt generate && cd capacitor && yarn cap sync ios",
    "test:smoke": "node scripts/smoke-build.mjs",
    "clean-reinstall": "rm -f yarn.lock && rm -f package-lock.json &&  rm -rf node_modules && CXXFLAGS=\"--std=c++17\" yarn install --force"
  },
  "dependencies": {
    "@awesome-cordova-plugins/core": "6.16.0",
    "@awesome-cordova-plugins/file-opener": "6.16.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.8",
    "@capacitor/device": "7.0.5",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@capgo/capacitor-updater": "7.50.2",
    "@ionic-native/core": "5.36.0",
    "@ionic-native/http": "5.36.0",
    "@nuxtjs/axios": "5.13.6",
    "@scbd/ckeditor5-build-inline-full": "35.0.0",
    "@scbd/conference-cal": "1.0.3",
    "bootstrap": "4.6.2",
    "camelcase-keys": "9.1.3",
    "localforage": "1.10.0",
    "lodash.debounce": "4.0.8",
    "luxon": "3.7.2",
    "nuxt": "2.18.1",
    "nuxt-i18n": "6.28.1",
    "object-sizeof": "2.6.5",
    "semver": "7.8.5",
    "sweetalert2": "11.26.25",
    "velocity-animate": "1.5.2",
    "vue": "2.7.16",
    "vue-cordova": "0.1.2",
    "vue-notifications": "1.0.2",
    "vue-server-renderer": "2.7.16",
    "vue-template-compiler": "2.7.16"
  },
  "devDependencies": {
    "babel-eslint": "10.1.0",
    "eslint": "7.32.0",
    "eslint-friendly-formatter": "4.0.1",
    "eslint-plugin-vue": "7.20.0",
    "replace": "1.2.2",
    "sass": "1.102.0",
    "sass-loader": "10.5.2"
  }
}
